# Read by `pnpm dev` in this app. The Docker images take the same values as build args instead, so this file is for running the app directly. Copy to .env; setup.sh does that for you.

# Empty base urls mean same-origin. Point VITE_API_BASE_URL at the API when running this app outside the proxy, e.g. http://localhost:8000.
VITE_API_BASE_URL=
VITE_API_BASE_PATH=/api
VITE_ADMIN_BASE_URL=
VITE_ADMIN_BASE_PATH=/admin
VITE_SPACE_BASE_URL=
VITE_SPACE_BASE_PATH=/spaces
VITE_LIVE_BASE_URL=
VITE_LIVE_BASE_PATH=/live
VITE_WEB_BASE_URL=
VITE_WEB_BASE_PATH=
