(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000
	
	reverse_proxy /live/* live:3000

	reverse_proxy /api/users/me/ api-go:8000
	reverse_proxy /api/users/session/ api-go:8000
	reverse_proxy /api/users/me/settings/ api-go:8000
	reverse_proxy /api/users/me/email/generate-code/ api-go:8000
	reverse_proxy /api/users/me/email/ api-go:8000
	reverse_proxy /api/users/me/profile/ api-go:8000
	reverse_proxy /api/users/me/accounts/ api-go:8000
	reverse_proxy /api/users/me/accounts/* api-go:8000
	reverse_proxy /api/users/me/instance-admin/ api-go:8000
	reverse_proxy /api/users/me/onboard/ api-go:8000
	reverse_proxy /api/users/me/tour-completed/ api-go:8000
	reverse_proxy /api/v1/users/me/ api-go:8000
	reverse_proxy /api/workspace-slug-check/ api-go:8000
	reverse_proxy /api/workspaces/ api-go:8000
	reverse_proxy /api/users/me/workspaces/ api-go:8000
	reverse_proxy /api/users/me/workspaces/invitations/ api-go:8000

	@go_workspace_core path_regexp go_workspace_core ^/api/workspaces/[^/]+/(members/(leave/|[0-9A-Fa-f-]+/)?|workspace-members/me/|workspace-views/|invitations/([0-9A-Fa-f-]+/(join/)?)?)?$
	reverse_proxy @go_workspace_core api-go:8000
	@go_workspace_themes path_regexp go_workspace_themes ^/api/workspaces/[^/]+/workspace-themes/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_workspace_themes api-go:8000
	@go_workspace_user_properties path_regexp go_workspace_user_properties ^/api/workspaces/[^/]+/user-properties/$
	reverse_proxy @go_workspace_user_properties api-go:8000
	@go_workspace_sidebar_preferences path_regexp go_workspace_sidebar_preferences ^/api/workspaces/[^/]+/sidebar-preferences/$
	reverse_proxy @go_workspace_sidebar_preferences api-go:8000
	@go_workspace_home_preferences path_regexp go_workspace_home_preferences ^/api/workspaces/[^/]+/home-preferences/([^/]+/)?$
	reverse_proxy @go_workspace_home_preferences api-go:8000
	@go_workspace_quick_links path_regexp go_workspace_quick_links ^/api/workspaces/[^/]+/quick-links/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_workspace_quick_links api-go:8000
	@go_project_core path_regexp go_project_core ^/api/workspaces/[^/]+/projects/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_project_core api-go:8000
	@go_project_members path_regexp go_project_members ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(members/([0-9A-Fa-f-]+/|leave/)?|project-members/me/|project-views/|preferences/member/[0-9A-Fa-f-]+/)$
	reverse_proxy @go_project_members api-go:8000
	@go_project_labels path_regexp go_project_labels ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(issue-labels/([0-9A-Fa-f-]+/)?|bulk-create-labels/)$
	reverse_proxy @go_project_labels api-go:8000
	@go_issue_interactions path_regexp go_issue_interactions ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/issues/[0-9A-Fa-f-]+/(reactions/([^/]+/)?|issue-subscribers/([0-9A-Fa-f-]+/)?|subscribe/|issue-links/([0-9A-Fa-f-]+/)?|comments/([0-9A-Fa-f-]+/)?|sub-issues/|issue-relation/|remove-relation/)$
	reverse_proxy @go_issue_interactions api-go:8000
	@go_issue_detail path_regexp go_issue_detail ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/issues/[0-9A-Fa-f-]+/$
	reverse_proxy @go_issue_detail api-go:8000
	@go_comment_reactions path_regexp go_comment_reactions ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/comments/[0-9A-Fa-f-]+/reactions/([^/]+/)?$
	reverse_proxy @go_comment_reactions api-go:8000
	reverse_proxy /api/users/me/workspaces/*/project-roles/ api-go:8000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api-go:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME} plane-minio:9000

	reverse_proxy /* web:3000
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}
