(plane_proxy) {
	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000
	
	reverse_proxy /live/* live:3000

	reverse_proxy /api/users/me/ api-go:8000
	reverse_proxy /api/users/session/ api-go:8000
	reverse_proxy /api/users/me/settings/ api-go:8000
	reverse_proxy /api/users/me/email/generate-code/ api-go:8000
	reverse_proxy /api/users/me/email/ api-go:8000
	reverse_proxy /api/users/me/profile/ api-go:8000
	reverse_proxy /api/users/me/accounts/ api-go:8000
	reverse_proxy /api/users/me/accounts/* api-go:8000
	reverse_proxy /api/users/me/instance-admin/ api-go:8000
	reverse_proxy /api/users/me/onboard/ api-go:8000
	reverse_proxy /api/users/me/tour-completed/ api-go:8000
	reverse_proxy /api/v1/users/me/ api-go:8000

	@go_external_attachments path_regexp go_external_attachments ^/api/v1/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(issues/[0-9A-Fa-f-]+/issue-attachments|work-items/[0-9A-Fa-f-]+/attachments)/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_external_attachments api-go:8000

	@go_external_issue_search path_regexp go_external_issue_search ^/api/v1/workspaces/[^/]+/(issues|work-items)/(search/|[^/]+-[^/-]*/)$
	reverse_proxy @go_external_issue_search api-go:8000

	@go_external_relations path_regexp go_external_relations ^/api/v1/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/work-items/[0-9A-Fa-f-]+/relations/$
	reverse_proxy @go_external_relations api-go:8000

	@go_external_activities path_regexp go_external_activities ^/api/v1/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(issues|work-items)/[0-9A-Fa-f-]+/activities/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_external_activities api-go:8000

	@go_external_comments path_regexp go_external_comments ^/api/v1/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(issues|work-items)/[0-9A-Fa-f-]+/comments/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_external_comments api-go:8000

	@go_external_links path_regexp go_external_links ^/api/v1/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(issues|work-items)/[0-9A-Fa-f-]+/links/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_external_links api-go:8000

	@go_external_project_detail path_regexp go_external_project_detail ^/api/v1/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/$
	reverse_proxy @go_external_project_detail api-go:8000

	@go_external_modules path_regexp go_external_modules ^/api/v1/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(modules-lite/|archived-modules/([0-9A-Fa-f-]+/unarchive/)?|modules/[0-9A-Fa-f-]+/archive/)$
	reverse_proxy @go_external_modules api-go:8000

	@go_external_cycles path_regexp go_external_cycles ^/api/v1/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(cycles-lite/|archived-cycles/([0-9A-Fa-f-]+/unarchive/)?|cycles/[0-9A-Fa-f-]+/archive/)$
	reverse_proxy @go_external_cycles api-go:8000

	@go_external_assets path_regexp go_external_assets ^/api/v1/workspaces/[^/]+/assets/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_external_assets api-go:8000

	@go_external_intake path_regexp go_external_intake ^/api/v1/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/intake-issues/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_external_intake api-go:8000

	@go_external_stickies path_regexp go_external_stickies ^/api/v1/workspaces/[^/]+/(stickies|invitations)/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_external_stickies api-go:8000

	@go_external_labels path_regexp go_external_labels ^/api/v1/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/labels/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_external_labels api-go:8000

	@go_external_members path_regexp go_external_members ^/api/v1/workspaces/[^/]+/(members/|members-lite/|projects/[0-9A-Fa-f-]+/(members|project-members)/([0-9A-Fa-f-]+/)?|projects/[0-9A-Fa-f-]+/project-members-lite/)$
	reverse_proxy @go_external_members api-go:8000

	@go_external_projects path_regexp go_external_projects ^/api/v1/workspaces/[^/]+/(projects-lite/|projects/[0-9A-Fa-f-]+/(archive|summary)/)$
	reverse_proxy @go_external_projects api-go:8000

	@go_external_states path_regexp go_external_states ^/api/v1/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/states/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_external_states api-go:8000
	reverse_proxy /api/workspace-slug-check/ api-go:8000
	reverse_proxy /api/workspaces/ api-go:8000
	reverse_proxy /api/users/me/workspaces/ api-go:8000
	reverse_proxy /api/users/me/workspaces/invitations/ api-go:8000

	@go_workspace_core path_regexp go_workspace_core ^/api/workspaces/[^/]+/(members/(leave/|[0-9A-Fa-f-]+/)?|workspace-members/me/|workspace-views/|invitations/([0-9A-Fa-f-]+/(join/)?)?)?$
	reverse_proxy @go_workspace_core api-go:8000
	@go_workspace_themes path_regexp go_workspace_themes ^/api/workspaces/[^/]+/workspace-themes/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_workspace_themes api-go:8000
	@go_workspace_user_properties path_regexp go_workspace_user_properties ^/api/workspaces/[^/]+/user-properties/$
	reverse_proxy @go_workspace_user_properties api-go:8000
	@go_workspace_sidebar_preferences path_regexp go_workspace_sidebar_preferences ^/api/workspaces/[^/]+/sidebar-preferences/$
	reverse_proxy @go_workspace_sidebar_preferences api-go:8000
	@go_workspace_home_preferences path_regexp go_workspace_home_preferences ^/api/workspaces/[^/]+/home-preferences/([^/]+/)?$
	reverse_proxy @go_workspace_home_preferences api-go:8000
	@go_workspace_quick_links path_regexp go_workspace_quick_links ^/api/workspaces/[^/]+/quick-links/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_workspace_quick_links api-go:8000
	@go_project_core path_regexp go_project_core ^/api/workspaces/[^/]+/projects/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_project_core api-go:8000
	@go_project_members path_regexp go_project_members ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(members/([0-9A-Fa-f-]+/|leave/)?|project-members/me/|project-views/|preferences/member/[0-9A-Fa-f-]+/)$
	reverse_proxy @go_project_members api-go:8000
	@go_project_labels path_regexp go_project_labels ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(issue-labels/([0-9A-Fa-f-]+/)?|bulk-create-labels/)$
	reverse_proxy @go_project_labels api-go:8000
	@go_project_issue_operations path_regexp go_project_issue_operations ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(bulk-archive-issues/|bulk-delete-issues/|deleted-issues/|user-properties/|archived-issues/|issue-dates/|issues-detail/|issues/[0-9A-Fa-f-]+/modules/)$
	reverse_proxy @go_project_issue_operations api-go:8000
	@go_work_item_description_versions path_regexp go_work_item_description_versions ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/work-items/[0-9A-Fa-f-]+/description-versions/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_work_item_description_versions api-go:8000
	@go_issue_interactions path_regexp go_issue_interactions ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/issues/[0-9A-Fa-f-]+/(reactions/([^/]+/)?|issue-subscribers/([0-9A-Fa-f-]+/)?|subscribe/|issue-links/([0-9A-Fa-f-]+/)?|comments/([0-9A-Fa-f-]+/)?|sub-issues/|issue-relation/|remove-relation/|archive/|history/|meta/|versions/([0-9A-Fa-f-]+/)?)$
	reverse_proxy @go_issue_interactions api-go:8000
	@go_work_item_identifier path_regexp go_work_item_identifier ^/api/workspaces/[^/]+/work-items/[^/]+/$
	reverse_proxy @go_work_item_identifier api-go:8000
	@go_analytic_views path_regexp go_analytic_views ^/api/workspaces/[^/]+/(analytic-view/([0-9A-Fa-f-]+/)?|export-analytics/|analytics/|saved-analytic-view/[0-9A-Fa-f-]+/|default-analytics/|project-stats/)$
	reverse_proxy @go_analytic_views api-go:8000

	@go_webhooks path_regexp go_webhooks ^/api/workspaces/[^/]+/(webhooks/([0-9A-Fa-f-]+/(regenerate/)?)?|webhook-logs/[0-9A-Fa-f-]+/)$
	reverse_proxy @go_webhooks api-go:8000

	@go_global_search path_regexp go_global_search ^/api/workspaces/[^/]+/(search|entity-search)/$
	reverse_proxy @go_global_search api-go:8000

	@go_issue_search path_regexp go_issue_search ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/search-issues/$
	reverse_proxy @go_issue_search api-go:8000

	@go_intakes path_regexp go_intakes ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(intakes|inboxes)/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_intakes api-go:8000

	@go_pages path_regexp go_pages ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(pages-summary/|pages/([0-9A-Fa-f-]+/(lock/|access/|archive/|description/|duplicate/|versions/([0-9A-Fa-f-]+/)?)?)?|favorite-pages/[0-9A-Fa-f-]+/)$
	reverse_proxy @go_pages api-go:8000

	@go_notifications path_regexp go_notifications ^/api/workspaces/[^/]+/users/notifications/(unread/|mark-all-read/|[0-9A-Fa-f-]+/(read/|archive/)?)?$
	reverse_proxy @go_notifications api-go:8000

	@go_workspace_views path_regexp go_workspace_views ^/api/workspaces/[^/]+/views/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_workspace_views api-go:8000

	@go_project_views path_regexp go_project_views ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(views/([0-9A-Fa-f-]+/)?|user-favorite-views/([0-9A-Fa-f-]+/)?)$
	reverse_proxy @go_project_views api-go:8000

	@go_module_basics path_regexp go_module_basics ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(modules/([0-9A-Fa-f-]+/)?|user-favorite-modules/([0-9A-Fa-f-]+/)?|modules/[0-9A-Fa-f-]+/(user-properties/|archive/|module-links/([0-9A-Fa-f-]+/)?|issues/)|archived-modules/)$
	reverse_proxy @go_module_basics api-go:8000
	@go_cycle_basics path_regexp go_cycle_basics ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/(cycles/([0-9A-Fa-f-]+/)?|cycles/date-check/|user-favorite-cycles/([0-9A-Fa-f-]+/)?|cycles/[0-9A-Fa-f-]+/(user-properties/|archive/|cycle-issues/|progress/|analytics/|transfer-issues/)|archived-cycles/)$
	reverse_proxy @go_cycle_basics api-go:8000
	@go_issue_sync path_regexp go_issue_sync ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/v2/issues/$
	reverse_proxy @go_issue_sync api-go:8000
	@go_issue_list path_regexp go_issue_list ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/issues/(list/)?$
	reverse_proxy @go_issue_list api-go:8000
	@go_issue_detail path_regexp go_issue_detail ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/issues/[0-9A-Fa-f-]+/$
	reverse_proxy @go_issue_detail api-go:8000
	@go_issue_attachments path_regexp go_issue_attachments ^/api/assets/v2/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/issues/[0-9A-Fa-f-]+/attachments/([0-9A-Fa-f-]+/)?$
	reverse_proxy @go_issue_attachments api-go:8000
	@go_comment_reactions path_regexp go_comment_reactions ^/api/workspaces/[^/]+/projects/[0-9A-Fa-f-]+/comments/[0-9A-Fa-f-]+/reactions/([^/]+/)?$
	reverse_proxy @go_comment_reactions api-go:8000
	reverse_proxy /api/users/me/workspaces/*/project-roles/ api-go:8000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api-go:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME} plane-minio:9000

	reverse_proxy /* web:3000
}

{
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}
