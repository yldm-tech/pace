# The API, worker, beat, migrator and live server all read this file. Copy to .env; setup.sh does that and appends a generated SECRET_KEY.

DEBUG=0

# The origin a browser reaches this installation on. Include the port when it is not 80, e.g. http://localhost:8080.
WEB_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost

# Whether the session and CSRF cookies carry Secure. Left unset, they do unless one of the origins above is plain http, which is how a local stack is told apart from a real one. Set it to 0 only if you are serving a real deployment over http and know what that means.
# SECURE_COOKIES=1

# ADMIN_BASE_URL is deliberately absent. The API builds the admin console's address as ADMIN_BASE_URL + ADMIN_BASE_PATH, and ADMIN_BASE_PATH already defaults to /god-mode/ -- so setting this to http://localhost/god-mode produces http://localhost/god-mode/god-mode/ and every redirect out of the console lands on a 404. Leave it unset and the API falls back to WEB_URL, which is right whenever the console is served from the same origin. Set it only when the console has an origin of its own, and then give the origin alone.

DATABASE_URL=postgresql://plane:plane@plane-db:5432/plane
REDIS_URL=redis://plane-redis:6379/
AMQP_URL=amqp://plane:plane@plane-mq:5672/plane

# Change both before exposing this to anyone. setup.sh generates SECRET_KEY; generate the other with: openssl rand -hex 32
SECRET_KEY=
LIVE_SERVER_SECRET_KEY=change-this-key-on-deployment

USE_MINIO=1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
MINIO_ENDPOINT_SSL=0
FILE_SIZE_LIMIT=5242880

API_KEY_RATE_LIMIT=60/minute
AUTHENTICATION_RATE_LIMIT=10/minute

# Comma-separated IPs, CIDR ranges and hostnames a webhook may target even though they resolve to private networks.
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=
