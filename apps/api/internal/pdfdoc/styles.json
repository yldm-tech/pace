{
  "styles": {
    "page": {
      "padding": 40,
      "fontFamily": "Inter",
      "fontSize": 11,
      "lineHeight": 1.6,
      "color": "#1f1f1f"
    },
    "title": {
      "fontSize": 24,
      "fontWeight": 600,
      "marginBottom": 20,
      "color": "#1f1f1f"
    },
    "heading1": {
      "fontSize": 20,
      "fontWeight": 600,
      "marginTop": 16,
      "marginBottom": 8,
      "color": "#1f1f1f"
    },
    "heading2": {
      "fontSize": 16,
      "fontWeight": 600,
      "marginTop": 14,
      "marginBottom": 6,
      "color": "#1f1f1f"
    },
    "heading3": {
      "fontSize": 14,
      "fontWeight": 600,
      "marginTop": 12,
      "marginBottom": 4,
      "color": "#1f1f1f"
    },
    "heading4": {
      "fontSize": 12,
      "fontWeight": 600,
      "marginTop": 10,
      "marginBottom": 4,
      "color": "#4d4d4d"
    },
    "heading5": {
      "fontSize": 11,
      "fontWeight": 600,
      "marginTop": 8,
      "marginBottom": 4,
      "color": "#4d4d4d"
    },
    "heading6": {
      "fontSize": 10,
      "fontWeight": 600,
      "marginTop": 6,
      "marginBottom": 4,
      "color": "#636363"
    },
    "paragraph": {
      "marginBottom": 0
    },
    "paragraphWrapper": {
      "marginBottom": 8
    },
    "blockquote": {
      "borderLeftWidth": 3,
      "borderLeftColor": "#d9d9d9",
      "paddingLeft": 12,
      "marginLeft": 0,
      "marginVertical": 8,
      "fontStyle": "normal",
      "fontWeight": 400,
      "color": "#1f1f1f",
      "breakInside": "avoid"
    },
    "codeBlock": {
      "backgroundColor": "#f5f5f5",
      "padding": 12,
      "borderRadius": 4,
      "fontFamily": "Courier",
      "fontSize": 10,
      "marginVertical": 8,
      "color": "#1f1f1f",
      "breakInside": "avoid"
    },
    "codeInline": {
      "backgroundColor": "#f5f5f5",
      "padding": 2,
      "paddingHorizontal": 4,
      "borderRadius": 2,
      "fontFamily": "Courier",
      "fontSize": 10,
      "color": "#dc2626"
    },
    "bulletList": {
      "marginVertical": 8,
      "paddingLeft": 0
    },
    "orderedList": {
      "marginVertical": 8,
      "paddingLeft": 0
    },
    "listItem": {
      "display": "flex",
      "flexDirection": "row",
      "gap": 6,
      "marginBottom": 4,
      "paddingRight": 10,
      "breakInside": "avoid"
    },
    "listItemBullet": {},
    "listItemContent": {
      "flex": 1
    },
    "taskList": {
      "marginVertical": 8
    },
    "taskItem": {
      "display": "flex",
      "flexDirection": "row",
      "gap": 6,
      "marginBottom": 4,
      "alignItems": "flex-start",
      "paddingRight": 10,
      "breakInside": "avoid"
    },
    "taskCheckbox": {
      "width": 12,
      "height": 12,
      "borderWidth": 1,
      "borderColor": "#d9d9d9",
      "borderRadius": 2,
      "marginTop": 2,
      "alignItems": "center",
      "justifyContent": "center"
    },
    "taskCheckboxChecked": {
      "backgroundColor": "#3f76ff",
      "borderColor": "#3f76ff"
    },
    "table": {
      "marginVertical": 8,
      "borderWidth": 1,
      "borderColor": "#e5e5e5"
    },
    "tableRow": {
      "flexDirection": "row",
      "borderBottomWidth": 1,
      "borderBottomColor": "#e5e5e5",
      "breakInside": "avoid"
    },
    "tableHeaderRow": {
      "backgroundColor": "#fafafa",
      "flexDirection": "row",
      "borderBottomWidth": 1,
      "borderBottomColor": "#e5e5e5"
    },
    "tableCell": {
      "padding": 8,
      "borderRightWidth": 1,
      "borderRightColor": "#e5e5e5",
      "flex": 1
    },
    "tableHeaderCell": {
      "padding": 8,
      "borderRightWidth": 1,
      "borderRightColor": "#e5e5e5",
      "flex": 1,
      "fontWeight": "bold"
    },
    "horizontalRule": {
      "borderBottomWidth": 1,
      "borderBottomColor": "#e5e5e5",
      "marginVertical": 16
    },
    "image": {
      "maxWidth": "100%",
      "marginVertical": 8
    },
    "imagePlaceholder": {
      "backgroundColor": "#f5f5f5",
      "padding": 16,
      "borderRadius": 4,
      "marginVertical": 8,
      "alignItems": "center",
      "justifyContent": "center",
      "borderWidth": 1,
      "borderColor": "#ebebeb",
      "borderStyle": "dashed"
    },
    "imagePlaceholderText": {
      "color": "#636363",
      "fontSize": 10
    },
    "callout": {
      "backgroundColor": "#f0f0f0",
      "padding": 12,
      "borderRadius": 6,
      "marginVertical": 8,
      "flexDirection": "row",
      "alignItems": "flex-start",
      "breakInside": "avoid"
    },
    "calloutIconContainer": {
      "marginRight": 10,
      "marginTop": 2
    },
    "calloutContent": {
      "flex": 1,
      "color": "#1f1f1f"
    },
    "mention": {
      "backgroundColor": "#e0e9ff",
      "color": "#3f76ff",
      "padding": 2,
      "paddingHorizontal": 4,
      "borderRadius": 2
    },
    "link": {
      "color": "#3f76ff",
      "textDecoration": "underline"
    },
    "bold": {
      "fontWeight": "bold"
    },
    "italic": {
      "fontStyle": "italic"
    },
    "underline": {
      "textDecoration": "underline"
    },
    "strike": {
      "textDecoration": "line-through"
    }
  },
  "colors": {
    "BACKGROUND_COLORS": {
