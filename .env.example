# Root environment for docker-compose.yml and docker-compose-local.yml. Copy to .env; setup.sh does that for you.

# The ports the proxy publishes on the host. Change both if something already holds 80/443, and put the same port in WEB_URL and CORS_ALLOWED_ORIGINS below.
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

# The address Caddy listens on inside the proxy container. This is the container's own port, not the host's, so it stays :80 even when LISTEN_HTTP_PORT changes.
SITE_ADDRESS=:80

POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane

RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane

# MinIO's root credentials, which are also the S3 credentials the API signs with.
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880

# The queue the Go worker consumes and everything else publishes to. Changing it means changing it for the api, worker and beat together, or work is published where nothing is listening.
PACE_WORKER_QUEUE=pace-go

# Where the frontends find each service, compiled into the bundles at build time. Empty base urls mean same-origin, which is what the proxy serves.
VITE_API_BASE_URL=
VITE_API_BASE_PATH=/api
VITE_ADMIN_BASE_URL=
VITE_ADMIN_BASE_PATH=/admin
VITE_SPACE_BASE_URL=
VITE_SPACE_BASE_PATH=/spaces
VITE_LIVE_BASE_URL=
VITE_LIVE_BASE_PATH=/live
VITE_WEB_BASE_URL=
VITE_WEB_BASE_PATH=
