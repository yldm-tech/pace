{
  "name": "@pace/codemods",
  "version": "1.4.40",
  "private": true,
  "scripts": {
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint --max-warnings=0 .",
    "check:types": "tsc --noEmit",
    "fix:format": "oxfmt .",
    "fix:lint": "oxlint --fix .",
    "function-declaration": "jscodeshift -t ./function-declaration.ts --extensions=tsx --parser=tsx ../../apps/*/app ../../apps/*/core ../../apps/*/helpers ../../packages/*/src --ignore-pattern='**/node_modules/**' --ignore-pattern='**/dist/**' --ignore-pattern='**/build/**' --ignore-pattern='**/*.d.ts'",
    "headlessui-v2-default-tags": "jscodeshift -t ./headlessui-v2-default-tags.ts --extensions=tsx --parser=tsx ../../apps/*/app ../../apps/*/core ../../apps/*/helpers ../../packages/*/src --ignore-pattern='**/node_modules/**' --ignore-pattern='**/dist/**' --ignore-pattern='**/build/**' --ignore-pattern='**/*.d.ts'",
    "icons-to-pace-propel": "jscodeshift -t ./icons-to-pace-propel.ts --extensions=ts,tsx --parser=tsx ../../apps/web/app ../../apps/web/core ../../apps/web/helpers ../../apps/space/app ../../apps/space/core ../../apps/space/helpers ../../packages/editor/src ../../packages/ui/src --ignore-pattern='**/node_modules/**' --ignore-pattern='**/dist/**' --ignore-pattern='**/build/**' --ignore-pattern='**/*.d.ts'",
    "remove-directives": "jscodeshift -t ./remove-directives.ts --extensions=ts,tsx --parser=tsx ../../apps/*/app ../../apps/*/core ../../apps/*/helpers ../../packages/*/src --ignore-pattern='**/node_modules/**' --ignore-pattern='**/dist/**' --ignore-pattern='**/build/**' --ignore-pattern='**/*.d.ts'",
    "test": "vitest run"
  },
  "devDependencies": {
    "@hypermod/utils": "catalog:",
    "@pace/typescript-config": "workspace:*",
    "@types/jscodeshift": "catalog:",
    "@types/node": "catalog:",
    "ast-types": "catalog:",
    "jscodeshift": "catalog:",
    "vitest": "catalog:"
  }
}
